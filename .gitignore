# codebase signature map: regenerated by `npm run repomix` in well under a
# second, so it is never committed — a stale map still gets trusted.
repomix-output.md

# Debug images written by the Python suite, relative to wherever it was run.
latestDebugRun/

# coverage artifacts (pytest-cov / c8). The report is uploaded to Codecov by
# CI; nothing about a local run belongs in the tree.
.coverage
.coverage.*
coverage/
coverage.xml
lcov.info
.nyc_output/

# written by the setup.sh of releases before 4.1.0
captchakraken.env

# python port
python/.venv
python/build/
python/dist/
**/__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# js port: the python engine is copied in at build time from the sibling
# repo-root python/ (single source of truth) — never commit the copy.
js/python/
js/dist/
js/node_modules/

# test-run artifacts
hcaptcha_5x_attempt_*.png
hcaptcha_5x_summary.json
captcha_video_summary.json
server_log.txt

# demo recorder (tests/record_demos.spec.ts) transients. Curated clips that the
