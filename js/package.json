{
  "name": "captchakraken",
  "version": "4.2.0",
  "description": "Captcha solver for Playwright and Puppeteer. Finds the captcha, reads it with the v2 pointer model, and clicks, drags, slides or types through to a token \u2014 reCAPTCHA, GeeTest, NetEase Yidun, Tencent, Lemin, Prosopo, Turnstile and distorted text. Hosted API or self-hosted.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "captchakraken": "bin/captchakraken.js"
  },
  "files": [
    "bin",
    "dist",
    "NOTICE",
    "python",
    "!python/**/__pycache__",
    "scripts/setup-python.js",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-python.mjs",
    "build": "tsc",
    "demo": "tsx examples/demoSites.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/*.test.js",
    "coverage": "tsc -p tsconfig.test.json && c8 node --test .test-build/*.test.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/setup-python.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptchaKraken/CaptchaKraken.git",
    "directory": "js"
  },
  "keywords": [
    "captcha",
    "captcha-solver",
    "recaptcha",
    "geetest",
    "turnstile",
    "yidun",
    "tencent-captcha",
    "playwright",
    "puppeteer",
    "camoufox",
    "browser-automation",
    "scraping",
    "anti-bot",
    "vllm",
    "qwen"
  ],
  "author": "Jake Writer",
  "license": "LGPL-3.0-only",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CaptchaKraken/CaptchaKraken/issues"
  },
  "homepage": "https://github.com/CaptchaKraken/CaptchaKraken#readme",
  "dependencies": {
    "cursory-js": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "c8": "12.0.0",
    "typescript": "5.9.3"
  }
}
